# --- AI sağlayıcıları (sırayla denenir) ---
AI_PROVIDERS=groq

GROQ_API_KEY=
# Virgülle birden fazla model: sırayla denenir; hiçbiri yoksa hesaptaki modeller otomatik bulunur
GROQ_MODEL=qwen/qwen3.5-27b,openai/gpt-oss-120b
GROQ_MODEL_STRONG=qwen/qwen3.5-27b,openai/gpt-oss-120b

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# GEMINI_MODEL_STRONG=gemini-2.0-flash

# Opsiyonel: xAI Grok (OpenAI uyumlu). Kullanmak için AI_PROVIDERS'a "xai" ekle.
# XAI_API_KEY=
# XAI_MODEL=grok-3-mini
# XAI_MODEL_STRONG=grok-3

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=false

# --- CV gizliliği (opsiyonel) ---
# Ayarlanırsa profile/cv.md yerine bu metin kullanılır (public repoda cv.md tutmamak için).
# CV_MD=...tam markdown metni...
# CV_MD_B64=...base64 kodlu cv.md (çok satırlı secret sorun çıkarırsa)...
